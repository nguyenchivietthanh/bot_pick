# ---- FMS (spx.shopee.vn) ----
# Tên trạm BDA hiển thị trong FMS - dùng để chọn role Chrome khi login và so
# khớp trip_station trả về từ API. Mặc định "BD B Mega SOC" (xác nhận từ
# nguyenchivietthanh/bot_deli_ver1).
BDA_HUB_CODE=BD B Mega SOC
# ID trạm BDA trong FMS, dùng lọc trip theo middle_station. Mặc định "4110"
# (xác nhận từ bot_deli_ver1).
BDA_STATION_ID=4110

# Chrome profile riêng cho BOT (không dùng chung Chrome cá nhân). Lần đầu
# chạy, Chrome sẽ tự mở - đăng nhập FMS thủ công 1 lần rồi Ctrl+C, các lần
# sau BOT tự dùng lại cookie đã đăng nhập. Các biến dưới đây đều tùy chọn,
# browser_fetch.py đã có default hợp lý - xem docstring của file đó.
# BOT_DELI_CHROME_USER_DATA_DIR=
# BOT_DELI_CHROME_PROFILE=Default
# BOT_DELI_BROWSER_GLOBAL_INTERVAL=0.25
# BOT_DELI_BROWSER_ENDPOINT_INTERVAL=0.8
# BOT_DELI_BROWSER_COOLDOWNS=5,15,30,60
# BOT_DELI_BROWSER_MAX_RETRIES=5
# BOT_DELI_BROWSER_RESTART_EVERY_REQUESTS=50

# ---- SQLite ----
SQLITE_DB_PATH=data/reconciliation.db

# ---- Google Sheets (bỏ trống nếu chưa dùng) ----
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/service_account.json
GOOGLE_SPREADSHEET_ID=
GOOGLE_WORKSHEET_NAME=MissingOrders

# ---- Vòng lặp / cửa sổ thời gian ----
# Tần suất quét (giây)
POLL_INTERVAL_SECONDS=120
# Khi mới khởi động lần đầu, quét ngược lại bao nhiêu giờ
INITIAL_LOOKBACK_HOURS=6
# Thời gian ân hạn sau khi LT đến trước khi coi là MISSING (phút)
GRACE_PERIOD_MINUTES=60
# Sau bao lâu kể từ khi LT đến thì chốt CONFIRMED_MISSING (giờ)
CONFIRM_HORIZON_HOURS=24
